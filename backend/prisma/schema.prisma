generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Novel {
  id        String      @id @default(uuid())
  title     String
  content   String
  status    String      @default("draft")
  analysis  String?     // JSON: 剧情分析结果 (outline, timeline, conflicts)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  characters Character[]
  scenes     Scene[]

  @@map("novels")
}

model Character {
  id       String  @id @default(uuid())
  novelId  String  @map("novel_id")
  name     String
  aliases  String  @default("[]")
  roleType String  @map("role_type")
  traits   String  @default("{}")

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@map("characters")
}

model Scene {
  id        String @id @default(uuid())
  novelId   String @map("novel_id")
  sceneNum  Int    @map("scene_num")
  location  String
  timeOfDay String @map("time_of_day")

  novel   Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  scripts Script[]

  @@map("scenes")
}

model Script {
  id          String   @id @default(uuid())
  sceneId     String   @map("scene_id")
  yamlContent String   @map("yaml_content")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@map("scripts")
}
