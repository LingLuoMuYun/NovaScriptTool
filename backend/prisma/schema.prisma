generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Novel {
  id        String      @id @default(uuid())
  title     String
  content   String
  status    String      @default("draft")
  analysis  String?     // JSON: 剧情分析结果 (outline, timeline, conflicts)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  characters       Character[]
  scenes           Scene[]
  annotations      Annotation[]
  dependencyEdges  DependencyEdge[]

  @@map("novels")
}

model Character {
  id       String  @id @default(uuid())
  novelId  String  @map("novel_id")
  name     String
  aliases  String  @default("[]")
  roleType String  @map("role_type")
  traits   String  @default("{}")

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@map("characters")
}

model Scene {
  id               String  @id @default(uuid())
  novelId          String  @map("novel_id")
  sceneNum         Int     @map("scene_num")
  location         String
  timeOfDay        String  @map("time_of_day")
  isLocked         Boolean @default(false)  @map("is_locked")
  lockedBy         String? @map("locked_by")
  currentVersionId String? @map("current_version_id")

  novel          Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  scripts        Script[]
  currentVersion Script?  @relation("SceneCurrentVersion", fields: [currentVersionId], references: [id])

  @@map("scenes")
}

model Script {
  id              String   @id @default(uuid())
  sceneId         String   @map("scene_id")
  yamlContent     String   @map("yaml_content")
  version         Int      @default(1)
  createdBy       String   @default("system") @map("created_by")
  parentVersionId String?  @map("parent_version_id")
  createdAt       DateTime @default(now()) @map("created_at")

  scene         Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  parentVersion Script?  @relation("ScriptVersions", fields: [parentVersionId], references: [id])
  childVersions Script[] @relation("ScriptVersions")
  sceneCurrent  Scene[]  @relation("SceneCurrentVersion")

  @@map("scripts")
}

model Annotation {
  id         String   @id @default(uuid())
  novelId    String   @map("novel_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  content    String
  type       String   @default("note")
  resolved   Boolean  @default(false)
  authorName String   @default("匿名") @map("author_name")
  blockIndex Int?     @map("block_index")
  createdAt  DateTime @default(now()) @map("created_at")

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@map("annotations")
}

model DependencyEdge {
  id              String  @id @default(uuid())
  novelId         String  @map("novel_id")
  sourceSceneNum  Int     @map("source_scene_num")
  targetSceneNum  Int     @map("target_scene_num")
  dependencyType  String  @map("dependency_type")
  weight          Float   @default(1.0)

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@map("dependency_edges")
}
